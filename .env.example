# Application
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug
APP_VERSION=0.1.0
SERVICE_NAME=kleido
AUTH_REGISTRATION_ENABLED=true   # set to false to disable the public /api/v1/auth/register endpoint

# Database
DATABASE_URL=postgres://user:password@localhost:5432/kleido?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME_MINUTES=30

# Redis (Sprint 2)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

# JWT (Sprint 2)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Seeding — admin account created on first startup if it doesn't exist yet
SEED_ADMIN_EMAIL=admin@kleido.local
SEED_ADMIN_PASSWORD=Admin1234!

# CLI
API_BASE_URL=http://localhost:8080

# OpenTelemetry tracing (Sprint 6)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317   # use "jaeger:4317" inside docker-compose
